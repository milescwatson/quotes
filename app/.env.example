# Explicit local UI preview only; ignored in production builds.
NUXT_PUBLIC_IDENTITY_FIXTURES=true

# For Cognito + the HTTP API, set fixtures=false and configure all four values.
# No secrets belong in NUXT_PUBLIC_* variables.
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_COGNITO_USER_POOL_ID=
NUXT_PUBLIC_COGNITO_CLIENT_ID=
NUXT_PUBLIC_COGNITO_DOMAIN=
