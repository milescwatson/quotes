      "sha256": "963a088ff07adf7fd2d52b8dae9fce02127b2abab457efe23dc4a5ddea35c9d7",
      "sql": "CREATE TABLE public.principals (\n    id bigint GENERATED BY DEFAULT AS IDENTITY (CACHE 1) PRIMARY KEY,\n    name text NOT NULL CHECK (name = btrim(name) AND length(name) BETWEEN 1 AND 120),\n    normalized_name text NOT NULL CHECK (normalized_name <> ''),\n    website_url text NOT NULL CHECK (length(website_url) BETWEEN 1 AND 2048),\n    website_key text NOT NULL CHECK (website_key <> '' AND website_key = lower(website_key)),\n    created_by_user_id bigint NOT NULL REFERENCES public.users(id) ON DELETE RESTRICT,\n    created_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CONSTRAINT principals_name_unique UNIQUE (normalized_name),\n    CONSTRAINT principals_website_unique UNIQUE (website_key)\n)",
      "status": "completed",
      "startedAt": "2026-10-12T22:06:47.976Z",
