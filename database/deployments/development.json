      "sql": "CREATE TABLE public.users (\n    id bigint GENERATED BY DEFAULT AS IDENTITY (CACHE 1) PRIMARY KEY,\n    cognito_issuer text NOT NULL CHECK (length(btrim(cognito_issuer)) > 0),\n    cognito_subject text NOT NULL CHECK (length(btrim(cognito_subject)) > 0),\n    email text NOT NULL CHECK (email = btrim(email) AND email <> ''),\n    normalized_email text NOT NULL\n        CHECK (normalized_email = lower(email) AND normalized_email <> ''),\n    display_name text CHECK (display_name = btrim(display_name) AND display_name <> ''),\n    created_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    disabled_at timestamptz,\n    auth_revision bigint NOT NULL DEFAULT 0 CHECK (auth_revision >= 0),\n    CONSTRAINT users_cognito_identity_unique UNIQUE (cognito_issuer, cognito_subject),\n    CHECK (updated_at >= created_at),\n    CHECK (disabled_at IS NULL OR disabled_at >= created_at)\n)",
      "status": "completed",
      "startedAt": "2026-10-10T21:33:04.352Z",
      "result": [],
      "completedAt": "2026-10-10T21:33:04.701Z"
    },
    {
