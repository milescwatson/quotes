      "sql": "CREATE TABLE public.organization_memberships (\n    id bigint GENERATED BY DEFAULT AS IDENTITY (CACHE 1) PRIMARY KEY,\n    organization_id bigint NOT NULL REFERENCES public.organizations(id) ON DELETE RESTRICT,\n    user_id bigint NOT NULL REFERENCES public.users(id) ON DELETE RESTRICT,\n    role text NOT NULL CHECK (role IN ('admin', 'editor', 'member')),\n    joined_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    removed_at timestamptz,\n    CONSTRAINT organization_membership_unique UNIQUE (organization_id, user_id),\n    CHECK (updated_at >= joined_at),\n    CHECK (removed_at IS NULL OR removed_at >= joined_at)\n)",
