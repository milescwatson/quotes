      "sql": "CREATE TABLE public.identity_audit_events (\n    id bigint GENERATED BY DEFAULT AS IDENTITY (CACHE 1) PRIMARY KEY,\n    organization_id bigint REFERENCES public.organizations(id) ON DELETE RESTRICT,\n    actor_type text NOT NULL CHECK (actor_type IN ('user', 'operator', 'system')),\n    actor_user_id bigint REFERENCES public.users(id) ON DELETE RESTRICT,\n    actor_principal text,\n    action text NOT NULL CHECK (length(btrim(action)) > 0),\n    entity_type text NOT NULL CHECK (entity_type IN ('user', 'organization', 'membership')),\n    entity_id bigint NOT NULL,\n    occurred_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    details jsonb NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(details) = 'object'),\n    request_id text NOT NULL CHECK (length(btrim(request_id)) > 0),\n    CONSTRAINT identity_audit_actor CHECK (\n        (actor_type = 'user' AND actor_user_id IS NOT NULL AND actor_principal IS NULL)\n        OR (actor_type IN ('operator', 'system') AND actor_user_id IS NULL\n            AND actor_principal IS NOT NULL AND length(btrim(actor_principal)) > 0))\n)",
